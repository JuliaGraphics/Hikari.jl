# Minimal pbrt reference: spectrum-class `scale` texture over an imagemap.
# Same flat quad + top-down camera as tex_diffuse_imagemap_light_point.pbrt,
# but the diffuse reflectance comes through a spectrum `scale` wrapper
# (replicating killeroo-gold's "sgrid = 0.5 * grid" pattern). The expected
# render is the imagemap pattern darkened uniformly to 50 % intensity.
# This is what Killeroo's grid floor exercises, and what the Hikari pbrt
# parser was extended to support (build_pbrt_textures' spectrum-class
# branch of the `scale` handler).

LookAt 0 0 2   0 0 0   0 1 0
Camera "perspective" "float fov" 60
Film "rgb" "integer xresolution" 128 "integer yresolution" 128
    "float maxcomponentvalue" 10
Integrator "volpath" "integer maxdepth" 4 "bool regularize" true

WorldBegin

LightSource "point" "rgb I" [20 20 20] "point3 from" [0 0 3]

Texture "stripes" "spectrum" "imagemap"
    "string filename" "textures/test_stripes.png"
Texture "stripes_half" "spectrum" "scale"
    "float scale" 0.5
    "texture tex" "stripes"

Material "diffuse" "texture reflectance" "stripes_half"
Shape "trianglemesh"
    "point3 P"   [ -1 -1 0   1 -1 0   1 1 0   -1 1 0 ]
    "point2 uv"  [  0  0     1  0    1 1    0 1    ]
    "integer indices" [ 0 1 2  0 2 3 ]
